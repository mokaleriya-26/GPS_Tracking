# ==========================================================
# Fleet Management Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# ==========================================================

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=no-reply@trackfleet.com

# Email Recipients
FLEET_EMAIL=fleet@trackfleet.com
MANAGER_EMAIL=manager@trackfleet.com

# MSG91 SMS Configuration
# Approved template name: Fleet_Alert
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SMS_TEMPLATE_ID=your_msg91_flow_template_id
MSG91_DLT_TEMPLATE_ID=your_dlt_template_id
MSG91_SENDER_ID=your_sender_id

# SMS Recipients (International format with country code, e.g. 919876543210)
FLEET_PHONE=919876543200
MANAGER_PHONE=919876543201
