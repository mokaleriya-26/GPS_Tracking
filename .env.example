# ============================================================
# GPS Fleet Tracking System — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ============================================================
# DATABASE (PostgreSQL + PostGIS)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gps_tracking
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password_here

# ============================================================
# SPRING BOOT BACKEND
# ============================================================
SERVER_PORT=8080

# ============================================================
# EMAIL NOTIFICATIONS (SMTP / Gmail)
# For Gmail: Enable 2FA and generate an App Password
# https://myaccount.google.com/apppasswords
# ============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=no-reply@trackfleet.com
FLEET_EMAIL=fleet@trackfleet.com
MANAGER_EMAIL=manager@trackfleet.com

# ============================================================
# SMS NOTIFICATIONS (MSG91)
# https://msg91.com — register and get auth key + template ID
# ============================================================
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SMS_TEMPLATE_ID=your_msg91_template_id_here
MSG91_SENDER_ID=TRCKFL
FLEET_PHONE=919876543200
MANAGER_PHONE=919876543201

# ============================================================
# PYTHON AI/ML SERVICE
# ============================================================
PYTHON_AI_SERVICE_URL=http://localhost:8000
PORT=8000

# ============================================================
# FRONTEND
# ============================================================
VITE_API_URL=http://localhost:8080

# ============================================================
# REPORTS OUTPUT DIRECTORY (server-side PDF generation)
# ============================================================
REPORTS_DIR=./reports/generated
